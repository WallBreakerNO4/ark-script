# MAA 辅助脚本配置文件
# 将此文件复制为 .env 并修改对应值

# 远程状态查询地址
URL=http://10.10.10.3:7070/stats

# 是否启用 Dry-Run 模式（true/false）
DRY_RUN=False

# ADB 设备地址（安卓手机/模拟器的 IP:Port）
ADB_DEVICE=192.168.20.103:5555

# 启动前等待时间（秒），发送通知后等待用户停止游玩的缓冲时间
STARTUP_WAIT=60

# Telegram Bot Token（用于发送通知消息）
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Telegram Chat ID（接收消息的目标聊天 ID）
TELEGRAM_CHAT_ID=your_chat_id_here

# 明日方舟官服包名（设为空值则不杀官服）
ARKNIGHTS_PACKAGE=com.hypergryph.arknights
# 明日方舟B服包名（设为空值则不杀B服）
ARKNIGHTS_PACKAGE_BILIBILI=com.hypergryph.arknights.bilibili

# 发送的通知消息内容
MSG_STARTUP=即将开始运行MAA！请立刻停止游玩明日方舟！
MSG_SKIP=MAA将跳过此次运行
